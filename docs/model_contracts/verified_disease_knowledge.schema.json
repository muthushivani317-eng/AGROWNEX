{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrowai.local/schemas/verified-disease-knowledge/v1",
  "title": "Verified Disease Knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["crop_id", "disease_class_id", "symptoms", "likely_cause", "recommended_actions", "prevention", "remedy_or_management", "evidence", "verification_status"],
  "properties": {
    "crop_id": {"type": "string", "minLength": 1},
    "disease_class_id": {"type": "string", "minLength": 1},
    "symptoms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "likely_cause": {"type": "string", "minLength": 1},
    "recommended_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prevention": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "remedy_or_management": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_document", "printed_page", "pdf_page_index", "verification_status"],
        "properties": {
          "source_document": {"type": "string", "minLength": 1},
          "printed_page": {"type": "string", "minLength": 1},
          "pdf_page_index": {"type": "integer", "minimum": 0},
          "verification_status": {"const": "VERIFIED"}
        }
      }
    },
    "verification_status": {"const": "VERIFIED"}
  }
}
