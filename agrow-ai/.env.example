# AgrowAI environment configuration.
# Copy to `.env` and fill in real values. All EXPO_PUBLIC_* vars are bundled
# into the client, so never put server secrets here.

# --- Build profile (production, internal_testing, kvk_field_test, or localStandalone) ---
EXPO_PUBLIC_APP_ENV=production

# --- Backend API ---
EXPO_PUBLIC_API_BASE_URL=https://api.agrowai.example.com
EXPO_PUBLIC_DIAGNOSIS_API_BASE_URL=https://api.agrowai.example.com

# Experimental models remain disabled in production unless explicitly approved.
EXPO_PUBLIC_GREEN_GRAM_EXPERIMENTAL_ENABLED=false

# --- Firebase (Phone OTP auth) ---
# Leave blank to run with the local mock auth provider (dev OTP = 123456).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Admin access allowlist ---
# Comma-separated phones/emails allowed past login (e.g. +919999999999,me@example.com).
# Leave blank to allow anyone in (local dev); set it in production to lock the app down.
EXPO_PUBLIC_ADMIN_ALLOWLIST=

# --- Mapbox (Farm boundary maps) ---
EXPO_PUBLIC_MAPBOX_TOKEN=
