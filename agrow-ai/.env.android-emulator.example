# Android Emulator development only. Copy to .env.local for an isolated local build.
# 10.0.2.2 is the Android Emulator alias for the Windows host.
AGROWAI_BUILD_PROFILE=localStandalone
EXPO_PUBLIC_APP_ENV=localStandalone
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_DIAGNOSIS_API_BASE_URL=http://10.0.2.2:8000

# Enable only for authorized local experimental testing. Production remains OFF.
EXPO_PUBLIC_GREEN_GRAM_EXPERIMENTAL_ENABLED=true
