FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system agrowai \
    && adduser --system --ingroup agrowai --home /app agrowai

COPY requirements.txt /app/requirements.txt
RUN pip install --no-compile -r /app/requirements.txt

COPY --chown=agrowai:agrowai . /app
USER agrowai

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD-SHELL curl --fail "http://127.0.0.1:${PORT:-8000}/healthz" || exit 1

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-8000}\" --proxy-headers --forwarded-allow-ips='*'"]
