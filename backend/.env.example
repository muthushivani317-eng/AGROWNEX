# AgrowAI backend configuration. Copy to `.env`; never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL + PostGIS (async driver)
DATABASE_URL=postgresql+asyncpg://agrowai:agrowai@localhost:5432/agrowai
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
# Response cache backend for idempotent reads (weather/market): memory | redis.
# Diagnoses and personalized chat are never cached.
CACHE_BACKEND=memory

# --- AI model routing & cost control (Phase 1) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-pro
GEMINI_CHAT_MODEL=gemini-2.5-flash
# INR cost per 1,000 tokens (override per deployment to match the real contract).
COST_PRO_INPUT_INR_PER_1K=0.106
COST_PRO_OUTPUT_INR_PER_1K=0.850
COST_FLASH_INPUT_INR_PER_1K=0.026
COST_FLASH_OUTPUT_INR_PER_1K=0.213

# Firebase Admin (JSON service-account string). Leave blank to disable auth
# verification during early local development.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# CORS (JSON list). In production this MUST be an explicit list — "*" refuses to boot.
CORS_ORIGINS=["*"]

# --- Security & abuse protection (Phase 2) ---
# Server-side secret for hashing refresh tokens/OTP fingerprints. Production refuses
# to boot if this is left as the dev default.
SESSION_SECRET=dev-only-insecure-secret-change-me
# Expose /docs and /openapi.json in production (default hidden).
EXPOSE_DOCS=false
# Rate limiting (requests/min per client) + max upload size (bytes, default 8MB).
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=8388608
# Per-farmer daily AI quota (protects the shared Gemini budget).
AI_DAILY_DISEASE_QUOTA=30
AI_DAILY_CHAT_QUOTA=100
# Refuse to boot production with a mock provider active unless explicitly allow-listed.
ALLOW_MOCK_PROVIDERS=false

# --- SMS OTP delivery (MSG91) ---
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AGROAI
MSG91_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=agrowai-storage
R2_REGION=auto
R2_PUBLIC_URL=