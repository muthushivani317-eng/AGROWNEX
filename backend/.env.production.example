# Production template only. Replace every CHANGE_ME value through the deployment
# platform's secret manager. Never commit a populated production environment file.
ENVIRONMENT=production
DEBUG=false
PUBLIC_API_URL=https://api.example.invalid
TRUSTED_HOSTS=["api.example.invalid"]
CORS_ORIGINS=["https://admin.example.invalid"]
ADMIN_WEB_ORIGINS=["https://admin.example.invalid"]
ADMIN_SESSION_COOKIE_NAME=__Host-agrowai_admin
ADMIN_SESSION_TTL_HOURS=8
ADMIN_REQUIRE_MFA=true
ADMIN_SENSITIVE_REAUTH_MINUTES=15
EXPOSE_DOCS=false

DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@postgres.internal:5432/agrowai
REDIS_URL=redis://redis.internal:6379/0
CACHE_BACKEND=redis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REQUEST_TIMEOUT_SECONDS=20

SESSION_SECRET=CHANGE_ME_IN_SECRET_MANAGER
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_CREDENTIALS_JSON=CHANGE_ME_IN_SECRET_MANAGER
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=CHANGE_ME_IN_SECRET_MANAGER
MSG91_SENDER_ID=AGROAI
MSG91_TEMPLATE_ID=CHANGE_ME

R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME_IN_SECRET_MANAGER
R2_SECRET_ACCESS_KEY=CHANGE_ME_IN_SECRET_MANAGER
R2_BUCKET_NAME=agrowai-storage
R2_REGION=auto
R2_PUBLIC_URL=https://media.example.invalid

RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=8388608
DISEASE_MAX_IMAGE_BYTES=8388608
DISEASE_MAX_IMAGE_PIXELS=25000000

DISEASE_MODEL_REQUIRED=true
DISEASE_MODEL_ARTIFACT_DIR=/models/mobilenetv3_small_v1
ALLOW_MOCK_PROVIDERS=false
NOTIFICATION_PROVIDER=fcm
SATELLITE_PROVIDER=

SENTRY_DSN=
LOG_JSON=true
METRICS_TOKEN=CHANGE_ME_IN_SECRET_MANAGER
